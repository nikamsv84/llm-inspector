import subprocess
import sys
import time
import os


def run_services():
    print("🚀 Starting Mini Burp Suite Services...")

    # پیدا کردن مسیر پوشه داشبورد
    base_dir = os.path.dirname(os.path.abspath(__file__))
    dashboard_dir = os.path.join(base_dir, "dashboard")

    # ۱. اجرای داشبورد FastAPI دقیقاً در محیط پوشه خودش
    dashboard_process = subprocess.Popen(
        ["uvicorn", "app:app", "--reload", "--port", "8000"],
        cwd=dashboard_dir  # این خط جادو می‌کنه و مشکل core رو حل می‌کنه!
    )
    print("✅ Dashboard launched at http://127.0.0.1:8000")

    time.sleep(1)

    # ۲. اجرای هسته پروکسی
    # 🛑 نیکا، نام فایل اصلی پروکسی‌ات رو اینجا بنویس (مثلا inspector_server.py)
    # اگر این فایل هم داخل پوشه dashboard هست، cwd=dashboard_dir رو به این هم اضافه کن
    proxy_filename = "inspector_server.py"

    proxy_process = subprocess.Popen(
        [sys.executable, proxy_filename]
    )
    print(f"✅ Proxy Core launched with {proxy_filename} on port 8080")

    try:
        dashboard_process.wait()
        proxy_process.wait()
    except KeyboardInterrupt:
        print("\n🛑 Stopping all services...")
        dashboard_process.terminate()
        proxy_process.terminate()
        print("👋 Services stopped successfully.")


if __name__ == "__main__":
    run_services()
