import os
from fastapi import FastAPI, Request, Form
from fastapi.templating import Jinja2Templates
from core import proxy_state
from fastapi.responses import RedirectResponse

app = FastAPI(title="Mini Burp Suite Dashboard")

current_dir = os.path.dirname(os.path.abspath(__file__))

templates = Jinja2Templates(directory=os.path.join(current_dir, "templates"))


@app.get("/")
def show_dashboard(request: Request):
    # Fetch the latest captured packet from the shared flag register
    packet_to_show = proxy_state["current_request"] if proxy_state["current_request"] else "No request intercepted yet."

    # Pass request as a direct parameter to satisfy Jinja2Templates requirements
    return templates.TemplateResponse(
        name="index.html",
        request=request,
        context={"captured_packet": packet_to_show}
    )


@app.post("/action")
def handle_intercept_action(user_action: str = Form(...), edited_packet: str = Form(...)
):
    # 1. Convert the modified request string from the frontend textarea to bytes
    # and store it in the dedicated state key for the proxy core to forward.
    proxy_state["modified_request_bytes"] = edited_packet.encode("utf-8")

    # 2. Update the proxy state action with the user's choice ('forward' or 'drop')
    # to break the waiting loop inside the interceptor proxy server.
    proxy_state["action"] = user_action

    # 3. Redirect the user back to the main dashboard page using an HTTP 303 See Other
    # response to clear the POST request and show the next captured packet.
    return RedirectResponse(url="/", status_code=303)
