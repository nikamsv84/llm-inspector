                        <td class="p-3 {method_color} font-bold">{pkt["method"]}</td>
                        <td class="p-3 text-gray-300">{pkt["path"]}</td>
                        <td class="p-3 text-gray-400">{pkt["status"]}</td>
                        <td class="p-3 {risk_color}">{pkt["risk"]}</td>
                    </tr>
        """

    html_content += """
                </tbody>
